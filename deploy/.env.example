# Copy to /home/ubuntu/glancesync-backend/.env on the VPS and fill in.
# The service reads it from its working directory; it is never committed.
DB_HOST=localhost
DB_PORT=5440
DB_NAME=glancesync
DB_USER=glancesync
DB_PASSWORD=change_me

SERVER_PORT=8083

# Uploaded pictures live here; back this folder up along with the database.
IMG_STORAGE_PATH=./data/images

SESSION_TTL_DAYS=7

# True once the site is served over https, so the session cookie is https-only.
COOKIE_SECURE=true

# TURN relay (coturn on this VPS). TURN_SECRET must equal static-auth-secret in
# /etc/turnserver.conf. Generate one with: openssl rand -hex 32
# URLs use the IPv4 address: coturn listens on IPv4 only, and the domain also has IPv6.
TURN_SECRET=change_me
TURN_URLS=turn:57.129.77.121:3478?transport=udp,turn:57.129.77.121:3478?transport=tcp

# Startup schema handling: none | validate | update | create | create-drop.
# Production: update (or validate). Never create/create-drop, which wipe all data.
DB_DDL_AUTO=update
# Never true in production: it adds 500 test accounts with a published password.
DB_SEED=false
